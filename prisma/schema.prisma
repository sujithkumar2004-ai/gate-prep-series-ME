generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("student")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subject {
  id        String   @id
  name      String
  section   String
  topics    Topic[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}

model Topic {
  id        String   @id
  subjectId String
  title     String
  weightage Int
  difficulty String  @default("Medium")
  priority   Int     @default(3)
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id])

  @@unique([subjectId, title])
  @@index([subjectId])
  @@index([weightage])
  @@index([priority])
}

model DailyTask {
  id             String   @id
  userId         String
  date           DateTime
  subjectId      String
  topicId        String
  type           String
  title          String
  plannedMinutes Int
  actualMinutes  Int      @default(0)
  status         String
  skipReason     String?
  completedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([date])
  @@index([status])
}

model DailyProgress {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime
  totalPlannedTasks    Int
  completedTasks       Int
  skippedTasks         Int
  pendingTasks         Int
  plannedMinutes       Int
  actualMinutes        Int
  completionPercentage Int
  dailyScore           Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model RevisionItem {
  id           String   @id
  userId       String
  sourceTaskId String
  subjectId    String
  topicId      String
  dueDate      DateTime
  cycle        String
  title        String
  status       String
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([dueDate])
  @@index([status])
}

model BacklogItem {
  id           String   @id
  userId       String
  taskId       String
  date         DateTime
  subjectId    String
  topicId      String
  title        String
  reason       String
  recoveryDate DateTime
  priority     String
  status       String
  recoveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([date])
  @@index([recoveryDate])
  @@index([status])
}

model PYQSession {
  id               String   @id
  userId           String
  date             DateTime
  subjectId        String
  topicId          String
  totalQuestions   Int
  correctQuestions Int
  wrongQuestions   Int
  timeSpentMinutes Int
  sourceYear       String
  retryNeeded      Boolean
  bookmarked       Boolean
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([date])
}

model PYQQuestion {
  id               String @id
  sessionId        String
  topicId          String
  label            String
  isCorrect        Boolean
  timeSpentMinutes Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sessionId])
  @@index([topicId])
}

model MockTest {
  id               String   @id
  userId           String
  mockNumber       Int
  date             DateTime
  totalMarks       Int
  score            Int
  attempted        Int
  correct          Int
  wrong            Int
  accuracy         Int
  timeSpentMinutes Int
  actionPlan       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([createdAt])
}

model MockSubjectScore {
  id        String @id @default(cuid())
  mockId    String
  subjectId String
  score     Int
  attempted Int
  correct   Int
  wrong     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mockId])
  @@index([subjectId])
}

model Mistake {
  id            String   @id
  userId        String
  sourceType    String
  sourceId      String
  subjectId     String
  topicId       String
  mistakeType   String
  questionLabel String
  explanation   String
  correctMethod String
  retryDate     DateTime
  isFixed       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fixedAt       DateTime?

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([retryDate])
  @@index([createdAt])
  @@index([isFixed])
}

model QuestionBankItem {
  id            String @id
  userId        String
  subjectId     String
  topicId       String
  questionLabel String
  source        String
  difficulty    String
  solved        Boolean
  accuracy      Int
  retryNeeded   Boolean
  bookmarked    Boolean
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([solved])
  @@index([bookmarked])
}

model DeepWorkSession {
  id               String   @id
  userId           String
  date             DateTime
  mode             String
  subjectId        String
  topicId          String
  taskId           String?
  plannedMinutes   Int
  completedMinutes Int
  status           String
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  pauseReason      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([date])
  @@index([status])
}

model DistractionLog {
  id        String   @id
  sessionId String
  reason    String
  timestamp DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([timestamp])
}

model WeeklyReview {
  id             String @id
  userId         String
  weekStartDate  DateTime
  weekEndDate    DateTime
  weeklyScore    Int
  reflectionNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, weekStartDate])
  @@index([userId])
  @@index([weekStartDate])
}

model MonthlyReview {
  id             String @id
  userId         String
  month          String
  expectedExamReadiness Int
  reflectionNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model ActiveRecallCard {
  id             String   @id
  userId         String
  cardType       String
  subjectId      String
  topicId        String
  front          String
  back           String
  lastReviewedAt DateTime?
  nextReviewAt   DateTime
  rating         String?
  confidence     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([subjectId])
  @@index([topicId])
  @@index([nextReviewAt])
  @@index([createdAt])
}

model EnergyLog {
  id          String @id
  userId      String
  date        DateTime
  sleepHours  Float
  energyLevel Int
  focusLevel  Int
  stressLevel Int
  workoutDone Boolean
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model GymLog {
  id               String @id
  userId           String
  date             DateTime
  routineTitle     String
  workoutCompleted Boolean
  bodyweight       Float?
  recoveryNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Reminder {
  id      String @id
  userId  String
  type    String
  title   String
  time    String
  enabled Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model SalaryEntry {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

model ExpenseEntry {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  category  String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
  @@index([category])
}

model AppSetting {
  id        String @id @default(cuid())
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}
